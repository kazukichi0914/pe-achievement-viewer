{
  "manifest_version": 3,
  "name": "PE 達成状況ビューア",
  "version": "1.0.0",
  "description": "Product Experts プロフィールの達成状況をポップアップで表示します。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://productexperts.withgoogle.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PE 達成状況",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
